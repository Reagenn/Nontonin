{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/sw.js",
      "destination": "/frontend/sw.js"
    },
    {
      "source": "/api/items",
      "destination": "/frontend/demo/items.json"
    },
    {
      "source": "/api/activity",
      "destination": "/frontend/demo/activity.json"
    },
    {
      "source": "/api/releases",
      "destination": "/frontend/demo/releases.json"
    }
  ]
}
